# VPS: copy to .env. Use a long RANDOM URL-safe password (letters, digits, - and _).
SITE_DOMAIN=pulse.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-password
BOT_TOKEN=
MAP_2GIS_KEY=
CONSENT_VERSION=2026-09-25
# Автоматическая минимизация данных. Закрытые/lost лиды старше срока анонимизируются.
CLIENT_DATA_RETENTION_DAYS=365
ANALYTICS_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
OUTBOX_RETENTION_DAYS=30
# Загруженные фото/планировки/PDF хранятся в Docker volume media_data.
# MEDIA_ROOT задаётся compose автоматически.
# Local backend without Docker:
# DATABASE_URL=postgres://pulse:password@localhost:5432/pulse
# PUBLIC_ORIGIN=http://localhost:8080
# NODE_ENV=development
# Frontend build: VITE_PULSE_MODE=api VITE_API_BASE_URL=/api/v1 npm run build
