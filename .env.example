# DATABASE_URL=postgres://pulse:password@localhost:5432/pulse
# PUBLIC_ORIGIN=http://localhost:8080
# NODE_ENV=development
# Frontend build: VITE_PULSE_MODE=api VITE_API_BASE_URL=/api/v1 npm run build
