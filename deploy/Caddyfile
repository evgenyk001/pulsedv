{
	servers {
		protocols h1 h2
	}
}

{$SITE_DOMAIN} {
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
				resp_headers delete
			}
		}
	}
	encode zstd gzip
	header {
		Alt-Svc "clear"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "microphone=(), usb=(), serial=()"
		-Server
	}

	@privateSearch path /api/* /media/* /pulsedv/mini-app/* /pulsedv/control-center/* /mini-app/* /control-center/*
	header @privateSearch X-Robots-Tag "noindex, nofollow"

	@control path /pulsedv/control-center/*
	header @control {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
		Referrer-Policy no-referrer
		Cache-Control "no-store"
	}

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}
	handle /ready {
		reverse_proxy api:3000
	}
	# Historical chat URLs must never be served as public static files.
	handle /media/chat/* {
		reverse_proxy api:3000
	}
	handle /media/private/* {
		respond 404
	}
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	redir /partner-offer /partner-offer/ 308
	redir /pulsedv/partner-offer /pulsedv/partner-offer/ 308
	handle_path /pulsedv/partner-offer/* {
		root * /srv/partner-offer
		file_server
	}
	redir /pulsedv/mini-app /pulsedv/mini-app/ 308
	handle_path /pulsedv/mini-app/* {
		root * /srv/mini-app
		file_server
	}

	redir /pulsedv/control-center /pulsedv/control-center/ 308
	handle_path /pulsedv/control-center/* {
		root * /srv/control-center
		file_server
	}

	@legacy path /pulsedv /pulsedv/
	redir @legacy / 308

	handle {
		root * /srv
		file_server
	}
}

www.pulsedv.ru {
	header Alt-Svc "clear"
	redir https://pulsedv.ru{uri} 308
}
