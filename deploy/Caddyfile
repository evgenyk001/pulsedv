{$SITE_DOMAIN} {
 encode zstd gzip
 header {
  X-Content-Type-Options nosniff
  Referrer-Policy strict-origin-when-cross-origin
  Strict-Transport-Security "max-age=31536000"
  Permissions-Policy "microphone=(), usb=(), serial=()"
  -Server
 }

 @control path /pulsedv/control-center/*
 header @control {
  Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
  Referrer-Policy no-referrer
  Cache-Control "no-store"
 }

 handle /api/* {
  reverse_proxy api:3000
 }
 handle /health {
  reverse_proxy api:3000
 }
 handle /ready {
  reverse_proxy api:3000
 }
 # Historical chat URLs must never be served as public static files.
 handle /media/chat/* {
  reverse_proxy api:3000
 }
 handle /media/private/* {
  respond 404
 }
 handle /media/* {
  root * /srv
  header Cache-Control "public, max-age=31536000, immutable"
  file_server
 }
 @root path /
 redir @root /pulsedv/ 302
 handle {
  root * /srv
  file_server
 }
}
