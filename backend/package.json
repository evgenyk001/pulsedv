{
  "name": "pulse-dv-backend-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "migrate": "node --import tsx src/migrate.ts",
    "bootstrap": "node --import tsx src/bootstrap.ts",
    "worker": "node --import tsx src/worker.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "@types/pg": "^8.15.5",
    "@electric-sql/pglite": "^0.5.8"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11",
    "tsx": "^4.20.5"
  }
}
